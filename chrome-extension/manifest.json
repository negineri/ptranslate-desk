{
  "manifest_version": 3,
  "name": "PTranslate for Chrome",
  "description": "PTranslate のサーバーまたはこのPCで、ページの選んだ文やページ全体を翻訳します。",
  "version": "0.0.1",
  "version_name": "0.0.0-dev",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "PTranslate",
    "default_popup": "action.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background.mjs",
    "type": "module"
  },
  "permissions": ["nativeMessaging", "activeTab", "contextMenus", "scripting", "storage"],
  "optional_host_permissions": ["https://*/*", "http://127.0.0.1/*", "http://localhost/*"],
  "commands": {
    "translate-selection": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "選んだ文を翻訳"
    },
    "translate-page": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "このページを翻訳"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["popup.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
