{
  "productName": "PTranslate Desk",
  "version": "0.0.0-dev",
  "identifier": "com.witenp.ptranslate-desk",
  "build": {
    "beforeDevCommand": {
      "script": "node build.mjs",
      "wait": true
    },
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "PTranslate Desk",
        "width": 1120,
        "minWidth": 640,
        "height": 760
      },
      {
        "label": "popup",
        "create": false,
        "title": "PTranslate Desk — 選んだ文を翻訳",
        "url": "popup.html",
        "width": 600,
        "height": 340,
        "visible": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["ptranslate"]
      }
    },
    "updater": {
      "requireSignedVersion": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxODYxNDY3RjM3MjFDRDAKUldUUUhITHpaeFNHc1IvTnlXKyt4MGJvbDdMVk04SkZ3aklYMndvOC9YdmNvdHM4d2RHcmVHckkK",
      "endpoints": [
        "https://github.com/negineri/ptranslate-desk/releases/latest/download/latest.json"
      ]
    }
  }
}
