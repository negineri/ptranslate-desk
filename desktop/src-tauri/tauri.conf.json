{
  "productName": "翻訳",
  "version": "0.1.0",
  "identifier": "com.witenp.ptranslate-desk",
  "build": {
    "beforeDevCommand": { "script": "node build.mjs", "wait": true },
    "beforeBuildCommand": "node build.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      { "label": "main", "title": "翻訳（モック）", "width": 1000, "height": 760 },
      { "label": "popup", "title": "選んだ文を翻訳", "url": "popup.html", "width": 460, "height": 340,
        "visible": false, "alwaysOnTop": true, "skipTaskbar": true, "resizable": false }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "13.0" }
  }
}
