# compose.yml の値。写して .env にし、権限を 600 にする (cp .env.example .env && chmod 600 .env)。
# 手順は docs/SELF_HOSTING_COMPOSE.md

# tailnet でのマシン名と、その完全な名前 (<TS_HOSTNAME>.<tailnet の名前>.ts.net)。
# tailnet の名前は Tailscale の管理画面の DNS のページにある
TS_HOSTNAME=ptranslate
PT_DOMAIN=ptranslate.example-tailnet.ts.net
# 空なら初回の起動時にログイン URL をログに出す。auth key を使うときだけ書く
TS_AUTHKEY=

# 生成した乱数。openssl rand -base64 32 の結果を貼る (2 つ別の値にする)
POCKET_ID_ENCRYPTION_KEY=
COOKIE_SECRET=

# Pocket ID の最初の管理者 (docker compose run --rm setup が作る)。ユーザー名は英小文字・数字・_ . -
PT_ADMIN=admin
PT_ADMIN_EMAIL=

# Web 用 (ptranslate-web) の client secret。docker compose run --rm setup が書く
WEB_CLIENT_SECRET=

# 翻訳エンジン。-np 本を同時に処理し、1 本あたり LLAMA_CTX / LLAMA_PARALLEL のコンテキスト
LLAMA_PARALLEL=2
LLAMA_CTX=32768
